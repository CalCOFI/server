api.calcofi.io {
	reverse_proxy plumber:8888
}

file.calcofi.io {
	root * /share/public
	encode zstd gzip
	file_server browse
}

# Browsable front door for the PUBLIC Google Cloud Storage buckets.
#
# Why this exists: storage.googleapis.com serves OBJECTS, not directories. It has
# no folder listing, so a URL ending in "/" 404s unless an object literally has
# that key — which is why the generated index.html pages had to be linked
# explicitly. This vhost rewrites any folder URL to its index.html, so folder
# browsing works the way people expect, under one clean hostname:
#
#   storage.calcofi.io/calcofi-db/ducklake/releases/          -> .../releases/index.html
#   storage.calcofi.io/calcofi-db/ducklake/releases/latest.txt -> the object
#
# Named "storage" rather than "gcs" so the URL survives a move to S3 or similar.
# The bucket allow-list is explicit: anything not named here is refused, so a
# private bucket can never be reached through this host even by exact path.
storage.calcofi.io {
	encode zstd gzip

	# Access log — the ONLY record of how these two are really used. Both serve
	# mostly machines (curl/R/Python pulling .csv, .nc, parquet), which run no
	# JavaScript, so the GA4 tag on their HTML pages sees the browsing minority
	# only. /share is bind-mounted from the host, so the nightly aggregator in
	# scripts/caddy_usage.sh can read these without entering the container.
	log {
		# static filename: Caddy rejects placeholders like {host} here
		output file /share/logs/caddy/storage.log {
			roll_size 64MiB
			roll_keep 14
			roll_keep_for 2160h
		}
		format json
	}


	# The root page is a generated object like every other index here, so there is
	# ONE generator and ONE skin (workflows/scripts/build_storage_index.R) rather
	# than HTML pasted into this file and drifting from the rest of the site.
	rewrite / /calcofi-files-public/_index/storage.html

	# robots.txt — served inline, BEFORE the bucket handler, so it cannot be lost
	# by an index regeneration and does not need a bucket object.
	#
	# The index pages are a browsable catalog and are welcome in search results.
	# The objects behind them are not: ctd-cast_full.nc alone is 1.5 GB, every
	# byte is proxied through this server (reverse_proxy, not a redirect), and a
	# crawl of the tree would be billed as VM egress. Two full downloads of that
	# one file were essentially all of one day's 3.1 GB.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `# Catalog pages: crawl away. Data objects: please do not.
User-agent: *
Crawl-delay: 10
Disallow: /*.nc$
Disallow: /*.nc4$
Disallow: /*.parquet$
Disallow: /*.duckdb$
Disallow: /*.zip$
Disallow: /*.tar$
Disallow: /*.gz$
` 200
	}

	@public path_regexp bucket ^/(calcofi-db|calcofi-files-public|calcofi-projects)(/|$)
	handle @public {
		# folder URL -> the index.html object standing in for a listing
		@dir path_regexp dir ^(.*)/$
		rewrite @dir {re.dir.1}/index.html
		reverse_proxy https://storage.googleapis.com {
			header_up Host storage.googleapis.com

			# Published NetCDF is versioned by DB release, but the BYTES are written
			# once: when a dataset is byte-identical to an earlier release we publish
			# a manifest and index for the new release without re-uploading a
			# multi-hundred-MB file. Object storage has no symlinks, so
			# .../netcdf/<ds>/<release>/<ds>.nc has no object behind it in those
			# releases. Redirect that miss to the release's index page, which names
			# the canonical object and the release it is identical to.
			#
			# Scoped to netcdf/*.nc 404s ONLY — a blanket 404 handler here would mask
			# every genuine missing object behind a redirect.
			@nc_missing status 404
			handle_response @nc_missing {
				@is_nc path_regexp ncpath ^/calcofi-files-public/netcdf/([^/]+)/([^/]+)/[^/]+\.nc$
				redir @is_nc https://storage.calcofi.io/calcofi-files-public/netcdf/{re.ncpath.1}/{re.ncpath.2}/ 302
				respond "Not found." 404
			}
		}
	}

	# anything outside the allow-list: refuse, and say where to go instead
	handle {
		header Content-Type "text/plain; charset=utf-8"
		respond `Not found.

Public buckets: /calcofi-db/  /calcofi-files-public/  /calcofi-projects/
Start here: https://storage.calcofi.io/
` 404
	}
}

