shiny.calcofi.io {
	reverse_proxy rstudio:3838
}

# One app per canonical short path (renamed 2026-08-25, per the calcofi.io
# naming pass): /station /hex /cruise /contour (spatial-unit explorers) and
# /ctd (dataset-specific; already short). The short Shiny paths are symlinks
# inside the rstudio container's /srv/shiny-server (a named volume):
#   docker exec rstudio ln -sfn /share/github/CalCOFI/db-viz-hex/app        /srv/shiny-server/hex
#   docker exec rstudio ln -sfn /share/github/CalCOFI/apps/db-viz-cruise    /srv/shiny-server/cruise
#   (the /contour symlink to apps/oceano is retired — see the @contour redirect below)
# (/hex previously pointed at the 2023 dev app apps_dev/hex_density, retired.)
# Old paths 308 below so deep links keep working, query strings included —
# {uri} carries the remaining path AND the query after strip_prefix.
app.calcofi.io {
	@hex_old path /db-viz-hex /db-viz-hex/*
	handle @hex_old {
		route {
			uri strip_prefix /db-viz-hex
			redir * /hex{uri} 308
		}
	}
	@int_old path /int /int/*
	handle @int_old {
		route {
			uri strip_prefix /int
			redir * /hex{uri} 308
		}
	}
	@intapp_old path /int-app /int-app/*
	handle @intapp_old {
		route {
			uri strip_prefix /int-app
			redir * /hex{uri} 308
		}
	}
	@cruise_old path /db-viz-cruise /db-viz-cruise/*
	handle @cruise_old {
		route {
			uri strip_prefix /db-viz-cruise
			redir * /cruise{uri} 308
		}
	}
	@datacheck_old path /datacheck /datacheck/*
	handle @datacheck_old {
		route {
			uri strip_prefix /datacheck
			redir * /cruise{uri} 308
		}
	}
	@contour_old path /oceano /oceano/*
	handle @contour_old {
		route {
			uri strip_prefix /oceano
			redir * /contour{uri} 308
		}
	}
	# Contour Explorer (apps/oceano, Shiny over the legacy PostgreSQL) RETIRED 2026-09-07: the Explorer's Contours
	# lens replaces it — kriging / IDW / spline in the browser with an error surface (workflows plan 2026-09-07,
	# D31; Ben: "let's finally retire the old contour app"). /contour and /oceano land on that lens.
	@contour path /contour /contour/*
	handle @contour {
		redir * "https://calcofi.io/explore/?lens=contour&var=temperature" 308
	}

	# Station Explorer (db-viz-station) — static, not Shiny. Canonical home
	# since 2026-08-25 (was https://calcofi.io/db-viz-station/ on GitHub
	# Pages, whose index.html now bounces old-host visitors here). Served
	# from the same /share/static symlink static.calcofi.io uses:
	#   /share/static/db-viz-station -> /share/github/CalCOFI/db-viz-station/public
	# Freshness comes from bebest's crontab git pull of that clone every
	# 30 min (Pages deploys and the weekly data refresh land as commits on
	# main) — see `crontab -l` as bebest.
	#
	# Cache-Control: no-cache means "revalidate by ETag before reuse", not "do
	# not store": a returning browser asks, gets 304 when nothing changed and
	# the new bytes when the 30-minute pull brought any. Without a header,
	# browsers apply heuristic freshness (a fraction of the file's age), and
	# index.html's hand-typed ?v=118 stayed the same URL across a new app.js, so
	# v2026.10.01's app.js (db-viz-station#16) never reached returning
	# browsers. This one header replaces the version counter as the mechanism.
	redir /station /station/ 308
	handle_path /station/* {
		root * /share/static/db-viz-station
		header Cache-Control "no-cache"
		encode zstd gzip
		file_server
	}

	handle {
		reverse_proxy rstudio:3838
	}
}

# static web apps — the static parallel to app.calcofi.io (Shiny). Each app is a
# symlink under /share/static/<app> pointing at that repo's built static dir, so
# it serves at https://static.calcofi.io/<app>/ (e.g. the station data portal).
# The apps use relative asset paths, so no per-app base-URL config is needed.
#   sudo mkdir -p /share/static
#   sudo ln -s /share/github/CalCOFI/2026-ucsb-station-data-portal/public /share/static/station-portal
static.calcofi.io {
	root * /share/static
	# same revalidate-by-ETag rule as app.calcofi.io/station/ for the twin copy
	# of db-viz-station (see the comment there); other apps keep their defaults.
	@station path /db-viz-station /db-viz-station/*
	header @station Cache-Control "no-cache"
	encode zstd gzip
	file_server browse
}

tile.calcofi.io {
	reverse_proxy pg_tileserv:7800
}

erddap.calcofi.io {
	# robots.txt — ERDDAP's own recommendation, adapted. Crawlers fill in
	# ERDDAP's data-request forms and generate an effectively infinite number of
	# expensive queries: of 2,966 requests on 2026-07-29, 1,712 carried a query
	# string and 1,593 hit /erddap/tabledap. 36 requests asked for this file and
	# got a 404, so the bots are looking for it.
	#
	# Blocks the DATA outputs by extension and the file browser; deliberately
	# leaves /erddap/info/, the dataset .html pages and the search UI crawlable,
	# because being findable is the point of publishing a catalog. Served from
	# Caddy rather than Tomcat so it needs no image rebuild.
	# Ref: https://erddap.github.io/docs/server-admin/additional-information
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `# Catalog pages: crawl away. Data requests: please do not —
# they are generated from forms and are effectively infinite.
#
# The named agents below are blocked outright: bulk scrapers and AI-training
# crawlers that take the catalog's cost without sending readers back to it.
# Search engines are deliberately NOT in this list — being findable is the
# point of publishing a catalog, so they fall through to the wildcard rules
# and keep the metadata pages while the data outputs stay disallowed.
#
# Note this file is advisory: the crawler that caused the 2026-09-08 outage
# ignored it and spoofed a browser UA. The enforced rule is the @bulk_data
# matcher in the Caddyfile; this list only reduces the well-behaved noise.
User-Agent: meta-externalagent
User-Agent: Meta-ExternalAgent
User-Agent: meta-externalfetcher
User-Agent: FacebookBot
User-Agent: GPTBot
User-Agent: ChatGPT-User
User-Agent: OAI-SearchBot
User-Agent: ClaudeBot
User-Agent: Claude-Web
User-Agent: anthropic-ai
User-Agent: CCBot
User-Agent: Bytespider
User-Agent: PerplexityBot
User-Agent: Google-Extended
User-Agent: Applebot-Extended
User-Agent: Amazonbot
User-Agent: cohere-ai
User-Agent: Diffbot
User-Agent: ImagesiftBot
User-Agent: omgili
User-Agent: Timpibot
User-Agent: YouBot
User-Agent: SemrushBot
User-Agent: AhrefsBot
User-Agent: MJ12bot
User-Agent: DotBot
Disallow: /

User-Agent: *
Crawl-delay: 10
Disallow: /erddap/files/
Disallow: /files/
Disallow: /images/
Disallow: /?
Disallow: /?*
Disallow: /*.asc*
Disallow: /*.csv*
Disallow: /*.dods*
Disallow: /*.esriAscii*
Disallow: /*.esriCsv*
Disallow: /*.geoJson*
Disallow: /*.htmlTable*
Disallow: /*.json*
Disallow: /*.mat*
Disallow: /*.nc*
Disallow: /*.odvTxt*
Disallow: /*.tsv*
Disallow: /*.xhtml*
Disallow: /*.geotif*
Disallow: /*.itx*
Disallow: /*.kml*
Disallow: /*.pdf*
Disallow: /*.png*
Disallow: /*.large*
Disallow: /*.small*
Disallow: /*.transparentPng*
Sitemap: https://erddap.calcofi.io/erddap/sitemap.xml
` 200
	}

	# Unconstrained bulk dumps — the 2026-09-08 outage. At 03:27:03 UTC a crawler
	# (57.141.4.40, Meta range, spoofing a Mac browser UA) asked for
	# /erddap/tabledap/calcofi_ctd-cast_full.json with NO query string, i.e. the
	# whole of the largest table. It gave up after 24.9 s — Caddy logged
	# `status=0, 0 bytes` — but ERDDAP does NOT cancel the underlying query when
	# the client disconnects, so it kept materializing the table. The working set
	# blew past 16 GB into file-backed pages, which are reclaimable, so the OOM
	# killer never fired: the box pinned at its 251.7 MB/s disk-read ceiling with
	# writes at zero for 5 h 40 m and had to be hard-reset. robots.txt below
	# already disallowed `*.json*`; robots.txt is advisory and this client ignored
	# it, so the rule has to be enforced here.
	#
	# Matches DATA outputs only, anchored with `$` so the metadata siblings still
	# pass: .das .dds .fgdc .iso19115 .html .graph .subset .ncHeader
	# .nccsvMetadata. No User-Agent exemption on purpose — the UA that took the
	# server down was a spoofed browser, so trusting UA would have let it through.
	# Constrained requests (any query string) are untouched; none of our own
	# consumers request a bare dump, they all link the .html pages.
	@bulk_data path_regexp bulk ^/erddap/(tabledap|griddap)/[^/]+\.(asc|csv|csvp|csv0|dataTable|dods|esriCsv|geoJson|htmlTable|itx|json|jsonlCSV|jsonlCSV1|jsonlKVP|mat|nc|ncCF|ncCFMA|nccsv|ncoJson|odvTxt|parquet|parquetWMeta|timeGaps|tsv|tsvp|tsv0|wav|xhtml)$
	handle @bulk_data {
		@unconstrained expression {http.request.uri.query} == ""
		handle @unconstrained {
			header Content-Type "text/plain; charset=utf-8"
			respond `403 — an unconstrained full-table download is not available here.

A request for a whole dataset with no query string can take the server down, so
it is refused. Two supported ways to get the same data:

1. Constrain the request. Add a column list and at least one bound, e.g.
     /erddap/tabledap/{dataset}.csv?time,latitude,longitude,depth_m&time>=2020-01-01
   Build one interactively from the dataset page:
     https://erddap.calcofi.io/erddap/tabledap/{dataset}.html

2. For bulk or whole-table work, use the release Parquet instead — it is faster,
   versioned and citable: https://calcofi.io/docs

Questions: https://github.com/CalCOFI/workflows/issues
` 403
		}
		reverse_proxy erddap:8080
	}

	handle {
		reverse_proxy erddap:8080
	}

	# Access log — the ONLY record of how these two are really used. Both serve
	# mostly machines (curl/R/Python pulling .csv, .nc, parquet), which run no
	# JavaScript, so the GA4 tag on their HTML pages sees the browsing minority
	# only. /share is bind-mounted from the host, so the nightly aggregator in
	# scripts/caddy_usage.sh can read these without entering the container.
	log {
		output file /share/logs/caddy/erddap.log {
			roll_size 64MiB
			roll_keep 14
			roll_keep_for 2160h
		}
		format json
	}
}

